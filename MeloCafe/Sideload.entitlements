<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets StikDebug attach to enable JIT. -->
	<key>get-task-allow</key>
	<true/>
	<!-- Only takes effect when the signing profile grants it (GetMoreRam). Under LiveContainer
	     the entitlements of LiveContainer itself apply instead of these. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
